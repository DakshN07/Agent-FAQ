# ===== Backend environment configuration =====
# Copy this file to `.env` and fill in real values.
#   cp .env.example .env        (macOS / Linux)
#   copy .env.example .env      (Windows PowerShell)

# Environment: development | production | test
NODE_ENV=development

# Port for the Express API server.
# 4000 is deliberate: the Next.js frontend uses 3000, and they must not collide.
PORT=4000

# ===== Required (server refuses to boot without these) =====
# MongoDB. Locally, run `docker compose up -d mongo` and use the value below.
MONGO_URI=mongodb://localhost:27017/agentfaq

# Any long random string. In production generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key

# ===== AI keys =====
# OPTIONAL. Users normally add their own Mistral key from the dashboard after
# signing up (Settings -> AI / Mistral API key). This is only a shared fallback
# for self-hosting, local dev, and CI — leave it blank if you don't need it.
# Get one at https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# Google Gemini — only used to auto-generate starter FAQs and event
# descriptions during onboarding. Entirely optional; without it those steps
# fall back to sensible defaults.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ===== Infrastructure =====
# Qdrant stores the FAQ embeddings that power semantic matching.
# The `faqs` collection is created automatically on first use — nothing to set up.
#   Local:  docker compose up -d qdrant
#   Cloud:  https://qdrant.tech → free 1GB cluster, then use the URL below
# If Qdrant is unreachable the FAQ bot cannot match answers, so `/health`
# reports it as `vectorDb.status`.
QDRANT_URL=http://localhost:6333
# Only needed for Qdrant Cloud. Leave blank for the local Docker instance.
QDRANT_API_KEY=

# Redis is optional — sessions fall back to in-process memory.
# Use a shared Redis in production so sessions survive restarts and work
# across multiple instances. Local: docker compose up -d redis
REDIS_URL=

# Comma-separated list of allowed CORS origins (required in production).
# This must be your FRONTEND url, not the API url.
CORS_ORIGINS=http://localhost:3000

# Public frontend base URL (used for invite links and emails)
FRONTEND_URL=http://localhost:3000

# Sentry error tracking (optional)
SENTRY_DSN=

# ===== Channel integrations (optional) =====
# Users connect their own Discord/Slack from the dashboard once these are set.
# Until then the Connect button returns a clear "not configured" message.

# Discord — https://discord.com/developers/applications
# Redirect URI must be exactly: https://<your-api>/api/oauth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Slack — https://api.slack.com/apps
# Redirect URI must be exactly: https://<your-api>/api/oauth/slack/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# REQUIRED for Slack to deliver messages at all. Requests without a valid
# signature are rejected rather than trusted.
SLACK_SIGNING_SECRET=

# Telegram has no bot OAuth — users paste a token from @BotFather instead,
# so no server-side credentials are needed.

# Legacy fallback tokens (a single shared bot for all events). Prefer letting
# users connect their own via the dashboard.
DISCORD_TOKEN=
TELEGRAM_BOT_TOKEN=

# ===== Email (team invites; optional) =====
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@agentfaq.com