# ==========================================================================
# REQUIRED — the server will refuse to boot (config/env.js) without these.
# ==========================================================================

# MongoDB connection string
MONGO_URI=mongodb://mongo:27017/agentfaq

# JWT signing secret — MUST be a strong random value (min 16 chars).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_secret_value

# Mistral API key — powers the LangGraph moderation/routing/FAQ agents & embeddings
MISTRAL_API_KEY=your_mistral_api_key

# ==========================================================================
# RECOMMENDED
# ==========================================================================

# Comma-separated list of allowed browser origins in production (CORS).
# Example: https://agent-faq.vercel.app,https://www.your-domain.com
CORS_ORIGINS=

# Public frontend base URL (used in invite links & emails)
FRONTEND_URL=http://localhost:3000

# Qdrant vector DB URL (defaults to http://localhost:6333 if unset)
QDRANT_URL=http://localhost:6333

# Redis URL for rate-limiting store & caching (optional but recommended)
REDIS_URL=redis://redis:6379

# Sentry error tracking (optional)
SENTRY_DSN=

# ==========================================================================
# OPTIONAL — integrations & extra AI providers
# ==========================================================================

# Discord Bot & OAuth
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret

# Slack OAuth + signing secret (required to verify Slack webhooks)
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret
SLACK_SIGNING_SECRET=your_slack_signing_secret

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# WhatsApp / Meta webhook verification
WHATSAPP_VERIFY_TOKEN=your_whatsapp_verify_token
WHATSAPP_APP_SECRET=your_whatsapp_app_secret

# SMTP (team invite emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=your_email@gmail.com

# Extra AI providers (not required — core pipeline uses Mistral)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Server
PORT=3000
NODE_ENV=production
