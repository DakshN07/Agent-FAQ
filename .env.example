# ===== Backend environment configuration =====
# Copy to .env and fill in real values. Required variables are enforced at boot.

# Environment: development | production | test
NODE_ENV=development

# Port for the Express server
PORT=3000

# ===== Required (server will refuse to boot without these) =====
MONGO_URI=your_mongodb_atlas_connection_string
JWT_SECRET=your_super_secret_jwt_key
MISTRAL_API_KEY=your_mistral_api_key

# ===== Recommended =====
# Comma-separated list of allowed CORS origins (required in production)
CORS_ORIGINS=http://localhost:3000
# Public frontend base URL (used for invite links and emails)
FRONTEND_URL=http://localhost:3000
# Redis URL for rate-limit stores (optional; falls back to in-memory)
REDIS_URL=
# Qdrant vector DB URL (optional)
QDRANT_URL=http://localhost:6333
# Sentry DSN for error tracking (optional)
SENTRY_DSN=

# ===== Optional AI providers =====
GEMINI_API_KEY=
OPENAI_API_KEY=

# ===== Channel integrations (optional) =====
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# ===== Email (team invites; optional) =====
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@agentfaq.com